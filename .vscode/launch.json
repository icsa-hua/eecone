{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",            
            "console": "integratedTerminal",
            "justMyCode": false,
            // Remove the "externalConsole" property
            // "program": "${file}",
            "module": "streamlit",
            "args": ["run", "${file}"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
            }
        }
    ]
}